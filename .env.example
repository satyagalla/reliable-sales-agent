# Optional for browsing stored demo data. Required for genuine model runs.
OPENAI_API_KEY=
# Alternative local adapter: LLM_PROVIDER=codex_cli (uses existing CLI login).
LLM_PROVIDER=openai
CODEX_MODEL=gpt-6.1-sol
CODEX_JUDGE_MODEL=gpt-6.1-sol
# Optional absolute native executable or bin/codex.js path.
CODEX_CLI_PATH=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
JUDGE_MODEL=gpt-5.4-mini
# Explicit estimates per million tokens; leave blank for unknown cost.
# GPT-5.4 mini standard rates checked 2026-10-29: input 0.75, output 4.50.
# Verify rates for your provider/model; no rate is silently assumed.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Set a strong secret before signed webhook ingestion. Demo seed uses a separate CLI.
WEBHOOK_SECRET=
TRUST_DESK_DB=data/trust-desk.sqlite
