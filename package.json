{
  "name": "trust-desk",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "smoke:model": "tsx --env-file-if-exists=.env scripts/smoke-model.ts",
    "status": "node scripts/status.mjs",
    "eval": "tsx --env-file-if-exists=.env scripts/evaluate.ts",
    "export": "tsx --env-file-if-exists=.env scripts/export.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:http": "tsx scripts/verify-http.ts",
    "format": "prettier --write src scripts tests *.json *.md --ignore-unknown",
    "format:check": "prettier --check src scripts tests *.json *.md --ignore-unknown"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
